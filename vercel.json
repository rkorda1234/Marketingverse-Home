{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/thank-you", "destination": "/thank-you.html" },
    { "source": "/avanti-way", "destination": "/avanti-way.html" },
    { "source": "/((?!thank-you|avanti-way).*)", "destination": "/index.html" }
  ]
}
