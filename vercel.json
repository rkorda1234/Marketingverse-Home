{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/thank-you", "destination": "/thank-you.html" },
    { "source": "/avanti-way", "destination": "/avanti-way.html" },
    { "source": "/saaga", "destination": "/saaga.html" },
    { "source": "/saaga-phase-2", "destination": "/saaga-phase-2.html" },
    { "source": "/((?!thank-you|avanti-way|saaga-phase-2|saaga).*)", "destination": "/index.html" }
  ]
}
